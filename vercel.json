{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-blog.mjs && node scripts/render-static-components.mjs",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(?:content|components|scripts|tests)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/migration(?:/.*)?",
      "status": 410
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/docs",
      "status": 308,
      "headers": {
        "Location": "/docs/"
      }
    },
    {
      "src": "/docs/(.*)",
      "dest": "https://cortrix.github.io/cortrix/$1"
    }
  ]
}
